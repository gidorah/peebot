# ==============================================================================
# PeeBot - Production Environment Template
# ==============================================================================
# This file documents all required environment variables for a production
# deployment on Coolify (or any Docker Compose-based host).
#
# HOW TO USE
# ----------
# Do NOT copy this file as .env — Coolify injects env vars directly into
# containers via its UI. Use this as a reference when configuring your
# Coolify project environment.
#
# Two categories of variables:
#
#   [COOLIFY UI]   Set these in Coolify → Project → Environment Variables.
#                  These are secrets or deployment-specific values.
#
#   [COMPOSE]      Already hardcoded in docker/prod/docker-compose.yml using
#                  Docker DNS names. Do NOT set these in Coolify — the compose
#                  file handles them internally.
#
# PASSWORD CONSTRAINTS
# --------------------
# All generated passwords MUST use only URL-safe, shell-safe characters:
#   alphanumeric  a-z  A-Z  0-9
#   hyphens       -
#   underscores   _
#
# Passwords containing single quotes ('), at signs (@), percent signs (%),
# or other special characters WILL break:
#   - SQL interpolation in docker/scripts/init-timescale.sh
#   - DATABASE_URL composition in docker/prod/docker-compose.yml
#
# Recommended generation command (safe characters only):
#   openssl rand -hex 32
# ==============================================================================


# ==============================================================================
# [COOLIFY UI] Django Configuration
# ==============================================================================

# Django secret key — used for all cryptographic signing (sessions, CSRF, etc.).
# Generate with:
#   python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
# Or (hex, URL-safe):
#   openssl rand -hex 50
SECRET_KEY=CHANGE-THIS-generate-with-openssl-rand-hex-50

# Must be False in production. Exposes internals and disables security checks.
DEBUG=False

# Comma-separated list of hostnames Django will accept requests for.
# Include the Coolify-assigned domain and/or your custom domain.
# Example: peebot.example.com,www.peebot.example.com
ALLOWED_HOSTS=your-coolify-domain.example.com

# Comma-separated list of trusted origins for Django's CSRF protection.
# Required for Django 4.0+ behind reverse proxies (Traefik/Coolify).
# Must include the full scheme (https://). Must match ALLOWED_HOSTS entries.
# Example: https://peebot.example.com,https://www.peebot.example.com
CSRF_TRUSTED_ORIGINS=https://your-coolify-domain.example.com


# ==============================================================================
# [COOLIFY UI] Database Configuration — TimescaleDB
# ==============================================================================

# PostgreSQL database name.
# Default: peebot (matches compose default — override if needed)
POSTGRES_DB=peebot

# PostgreSQL superuser for the application database.
# Default: peebot_user (matches compose default — override if needed)
POSTGRES_USER=peebot_user

# PostgreSQL password — REQUIRED, no default in production.
# See PASSWORD CONSTRAINTS above.
# Generate: openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE-THIS-generate-with-openssl-rand-hex-32


# ==============================================================================
# [COOLIFY UI] PgBouncer Authentication
# ==============================================================================

# Password for the pgbouncer_auth PostgreSQL role.
# This role is created by docker/scripts/init-timescale.sh on first DB init.
# The PgBouncer entrypoint generates /etc/pgbouncer/userlist.txt from this
# at container start — userlist.txt is never stored in git.
#
# IMPORTANT: Must stay in sync with POSTGRES_PASSWORD usage context:
#   - TimescaleDB init script reads this to CREATE ROLE pgbouncer_auth.
#   - PgBouncer entrypoint reads this to write userlist.txt.
#   - Both consume it from the same env var — no double-entry.
#
# See PASSWORD CONSTRAINTS above.
# Generate: openssl rand -hex 32
PGBOUNCER_AUTH_PASSWORD=CHANGE-THIS-generate-with-openssl-rand-hex-32


# ==============================================================================
# [COOLIFY UI] External APIs — OpenRouter (LLM / Joke Generation)
# ==============================================================================

# OpenRouter API key — used to generate pee jokes via DeepSeek/other LLMs.
# Get yours at: https://openrouter.ai/keys
# Without this, the PeeBot processor will still detect UPA events but skip
# joke generation and Bluesky posting.
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key-here

# Optional: Override the OpenRouter API base URL (defaults to https://openrouter.ai/api/v1)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: Override the default LLM model (defaults to deepseek/deepseek-chat)
# See available models: https://openrouter.ai/models
# OPENROUTER_MODEL=deepseek/deepseek-chat

# Optional: Joke generation retry configuration
# JOKE_GENERATOR_MAX_RETRIES=3
# JOKE_GENERATOR_BASE_DELAY=1.0


# ==============================================================================
# [COOLIFY UI] External APIs — Bluesky (Social Posting)
# ==============================================================================

# Bluesky account handle and app password for posting detected UPA events.
# Create an account at: https://bsky.app
# Generate an App Password: Settings → Privacy and Security → App Passwords → Add App Password
# Without these, events are detected and logged but not posted publicly.
BLUESKY_HANDLE=your-handle.bsky.social
BLUESKY_APP_PASSWORD=your-bluesky-app-password-here

# Optional: Minimum minutes between Bluesky posts (default: 30, prevents spam)
# BLUESKY_COOLDOWN_MINUTES=30


# ==============================================================================
# [COOLIFY UI] Sentry (Optional — Error Tracking)
# ==============================================================================

# Sentry Data Source Name — enables error and performance tracking.
# Leave unset to disable Sentry entirely (safe for a fresh deployment).
# Get your DSN at: https://sentry.io → Project → Settings → Client Keys (DSN)
# SENTRY_DSN=https://your-public-key@your-org.ingest.sentry.io/your-project-id

# Identifies the deployment environment in Sentry (e.g. production, staging).
# SENTRY_ENVIRONMENT=production

# Fraction of transactions to send to Sentry for performance monitoring (0.0–1.0).
# 1.0 = 100% (fine for low-traffic apps). Lower for high-volume deployments.
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Minimum log level forwarded to Sentry Logs (DEBUG, INFO, WARNING, ERROR, CRITICAL).
# INFO captures info, warning, error, and critical log records in Sentry's Logs UI.
# SENTRY_LOGS_LEVEL=INFO


# ==============================================================================
# [COMPOSE] Internal Service URLs — DO NOT SET IN COOLIFY
# ==============================================================================
# These are already defined in docker/prod/docker-compose.yml using Docker DNS
# names (pgbouncer, redis). Setting them in Coolify UI would override the
# correct compose values and likely break connectivity.
#
# For reference only — these are set automatically by the compose file:
#
# DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@pgbouncer:6432/${POSTGRES_DB}?application_name=django-web
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/0
# REDIS_URL=redis://redis:6379/0
# DJANGO_SETTINGS_MODULE=config.settings.production
