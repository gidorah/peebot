# ==============================================================================
# PeeBot - Docker Build Context Exclusions
# Django Modular Monolith with TimescaleDB
# ==============================================================================
# This file defines what should NOT be sent to Docker daemon during build
# Goal: Reduce build context size, improve build speed, prevent secret leaks
# ==============================================================================

# ------------------------------------------------------------------------------
# Version Control
# ------------------------------------------------------------------------------
.git
.gitignore
.gitattributes
.github

# ------------------------------------------------------------------------------
# Documentation & Planning
# ------------------------------------------------------------------------------
*.md
!requirements.md
LICENSE
docs/
obsidian/

# ------------------------------------------------------------------------------
# Python Development
# ------------------------------------------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments (installed during build)
.venv/
venv/
env/
ENV/
.Python

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# ------------------------------------------------------------------------------
# Environment & Secrets (CRITICAL - DO NOT INCLUDE IN IMAGE)
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
.envrc

# Keep template for reference
!.env.example

# ------------------------------------------------------------------------------
# Django Development
# ------------------------------------------------------------------------------
# Logs (generate fresh in container)
*.log

# Local settings
local_settings.py

# SQLite (project uses TimescaleDB)
db.sqlite3
db.sqlite3-journal

# Static files (collected during build/runtime)
/static/
/staticfiles/
/static_root/

# Media files (mounted as volume in production)
/media/
/mediafiles/

# ------------------------------------------------------------------------------
# Docker & Database Volumes
# ------------------------------------------------------------------------------
# Docker Compose overrides (local dev only)
docker-compose.override.yml

# Local database volumes
postgres_data/
timescaledb_data/
db_data/

# Redis data
redis_data/

# Database dumps
*.sql
*.dump
*.backup

# Keep initialization scripts
!docker/**/init*.sql
!**/migrations/*.sql

# ------------------------------------------------------------------------------
# Celery
# ------------------------------------------------------------------------------
celerybeat-schedule
celerybeat-schedule.*
celerybeat.pid
celery_worker.state
worker*.state

# ------------------------------------------------------------------------------
# Testing & Coverage (exclude if not running tests in container)
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/

# If you need to run tests in container, comment out above and use:
# !tests/
# !pytest.ini

# ------------------------------------------------------------------------------
# Type Checking & Linting
# ------------------------------------------------------------------------------
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pyre/
.pytype/

# ------------------------------------------------------------------------------
# IDEs & Editors
# ------------------------------------------------------------------------------
# VSCode
.vscode/
*.code-workspace

# PyCharm / IntelliJ
.idea/

# Cursor
.cursorignore
.cursorindexingignore

# Vim
*.swp
*.swo
*~

# Emacs
\#*\#
.\#*

# Sublime Text
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------------------------
# macOS
# ------------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*

# ------------------------------------------------------------------------------
# Project-Specific
# ------------------------------------------------------------------------------
# Temporary work directory (per CLAUDE.md)
_work-tmp/

# Local development scripts (not for production)
scripts/local/

# Jupyter Notebooks
.ipynb_checkpoints/
*.ipynb

# IPython
profile_default/
ipython_config.py

# ------------------------------------------------------------------------------
# Package Managers
# ------------------------------------------------------------------------------
# PEP 582
__pypackages__/

# PyPI (credentials)
.pypirc

# ------------------------------------------------------------------------------
# Misc
# ------------------------------------------------------------------------------
# Rope
.ropeproject/

# Cython debug
cython_debug/

# Translations (if using, remove this)
*.mo
*.pot

# Added for T005
tests/
docker/dev/
docker/scripts/
logs/
.env.docker
