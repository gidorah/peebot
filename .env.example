# ==============================================================================
# PeeBot Environment Configuration
# ==============================================================================
# Copy this file to .env and update the values for your environment
#
# For Docker Compose development (default):
#   - Use service names as hostnames (pgbouncer, timescaledb, redis)
#   - Port mapping handled by Docker Compose
#
# For local development without Docker:
#   - Use localhost as hostname
#   - Uncomment local development section below
# ==============================================================================

# ==============================================================================
# Django Configuration
# ==============================================================================

# Django Settings Module (optional - has sensible defaults)
# Development: config.settings.development (default in manage.py)
# Production:  config.settings.production (default in wsgi.py/asgi.py)
# DJANGO_SETTINGS_MODULE=config.settings.development

# Django Secret Key (generate a new one for production)
# Generate with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=django-insecure-CHANGE-THIS-IN-PRODUCTION

# Debug mode (True for development, False for production)
DEBUG=True

# Allowed hosts (comma-separated list)
ALLOWED_HOSTS=localhost,127.0.0.1

# ==============================================================================
# Database Configuration - PostgreSQL / TimescaleDB
# ==============================================================================

# Database credentials (used by TimescaleDB container and connection strings)
POSTGRES_DB=peebot
POSTGRES_USER=peebot_user
POSTGRES_PASSWORD=password

# PgBouncer authentication user (for admin access)
# ⚠️ WARNING: This password must stay in sync with:
#   1. docker/dev/pgbouncer/userlist.txt (SCRAM-SHA-256 hash)
#   2. docker/scripts/init-timescale.sql (CREATE ROLE command)
# Use docker/dev/pgbouncer/generate_userlist.sh to update the hash
PGBOUNCER_AUTH_PASSWORD=pgbouncer_auth_password

# ==============================================================================
# === DOCKER COMPOSE DEVELOPMENT (DEFAULT) ===
# ==============================================================================
# When running via Docker Compose, services use DNS names (pgbouncer, redis)
# Port mappings:
#   - PgBouncer:     localhost:6432 (pooled)
#   - TimescaleDB:   localhost:5432 (direct)
#   - Redis:         localhost:6379

# Django database connection (via PgBouncer connection pool)
# The application_name parameter helps identify connections in PgBouncer stats
DATABASE_URL=postgresql://peebot_user:password@localhost:6432/peebot?application_name=django-web

# Celery & Redis configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# === LOCAL DEVELOPMENT WITHOUT DOCKER (OPTIONAL) ===
# ==============================================================================
# Uncomment these if running services locally without Docker Compose
#
# PgBouncer connection details
# PGBOUNCER_HOST=localhost
# PGBOUNCER_PORT=6432
#
# Worker/Beat connection strings (different application_name for pool tracking)
# DATABASE_URL_WORKER=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${PGBOUNCER_HOST}:${PGBOUNCER_PORT}/${POSTGRES_DB}?application_name=django-worker
# DATABASE_URL_BEAT=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${PGBOUNCER_HOST}:${PGBOUNCER_PORT}/${POSTGRES_DB}?application_name=django-beat
#
# Direct TimescaleDB access (for psql, GUI tools, debugging - bypasses PgBouncer)
# TIMESCALE_DIRECT_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# ==============================================================================
# External API Configuration
# ==============================================================================
# These are required for the event processors to generate jokes and post to Bluesky.
# Without these, the PeeBot processor will still detect events but won't post.

# --- OpenRouter / LLM Configuration ---
# Get your API key from: https://openrouter.ai/keys
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Override default endpoint (defaults to https://openrouter.ai/api/v1)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: Override default model (defaults to deepseek/deepseek-chat)
# See available models: https://openrouter.ai/models
# OPENROUTER_MODEL=deepseek/deepseek-chat

# Optional: Joke generation retry configuration
# JOKE_GENERATOR_MAX_RETRIES=3
# JOKE_GENERATOR_BASE_DELAY=1.0

# --- Bluesky API Configuration ---
# Create account at: https://bsky.app
# Generate App Password: Settings → App Passwords → Create new
# BLUESKY_HANDLE=yourhandle.bsky.social
# BLUESKY_APP_PASSWORD=your_app_password_here

# Optional: Cooldown between posts in minutes (default: 30)
# BLUESKY_COOLDOWN_MINUTES=30


# ==============================================================================
# Sentry Configuration (Optional)
# ==============================================================================
# Set SENTRY_DSN to enable error tracking via Sentry.
# Leave blank (or unset) to disable Sentry entirely.
# Get your DSN at: https://sentry.io → Project → Settings → Client Keys (DSN)
#
# Features enabled when SENTRY_DSN is set:
#   - Error tracking (exceptions forwarded to Sentry Issues)
#   - Performance monitoring (Django request and Celery task spans)
#   - Sentry Crons (Celery Beat periodic tasks monitored as check-ins)
#   - Sentry Logs (Python log records forwarded to Sentry's Logs UI)
#   - Custom metrics (processor.run, processor.readings, processor.event_detected,
#     processor.post_published — emitted by the PeeBot event processor)
# SENTRY_DSN=https://your-public-key@your-org.ingest.sentry.io/your-project-id
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=1.0
# Minimum log level forwarded to Sentry Logs (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# SENTRY_LOGS_LEVEL=INFO


# ==============================================================================
# Connection Pool Notes
# ==============================================================================
# Two ways to access the database:
#
# 1. Via PgBouncer (port 6432) - RECOMMENDED for application code
#    - Connection pooling and management
#    - Optimized for Django web/worker/beat processes
#    - Use for all Django database operations
#
# 2. Direct to TimescaleDB (port 5432) - Use for admin/tooling only
#    - Direct PostgreSQL access
#    - For psql, pgAdmin, database migrations, manual queries
#    - Bypasses PgBouncer (no pooling)
#
# Django is configured with CONN_MAX_AGE=0 to work optimally with PgBouncer.
# This means Django closes connections immediately, letting PgBouncer manage
# the connection pool efficiently.
# ==============================================================================
